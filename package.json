{
  "name": "anka-web",
  "version": "1.5.2",
  "description": "Anka Web Tarayıcısı",
  "main": "src/core/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "node build/prebuild.js && npx electron-builder --win",
    "build:linux-dir": "node build/prebuild.js && npx electron-builder --linux --dir",
    "build:linux-tar": "npx electron-builder --linux tar.gz",
    "build:linux": "npm run build:linux-dir && npm run build:linux-tar && node build/pack-linux.js",
    "build:all": "npm run build:win && npm run build:linux"
  },
  "author": "WraitGame <wraitstudio@gmail.com>",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "javascript-obfuscator": "^5.4.3"
  },
  "build": {
    "appId": "com.wraitgame.ankaweb",
    "productName": "Anka Web",
    "compression": "maximum",
    "asar": true,
    "directories": {
      "output": "dist/${version}"
    },
    "files": [
      "src/**/*",
      "icons/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Web Baglantisi",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "html",
        "name": "HTML Document",
        "role": "Viewer"
      },
      {
        "ext": "htm",
        "name": "HTML Document",
        "role": "Viewer"
      },
      {
        "ext": "shtml",
        "name": "HTML Document",
        "role": "Viewer"
      },
      {
        "ext": "xhtml",
        "name": "HTML Document",
        "role": "Viewer"
      },
      {
        "ext": "pdf",
        "name": "Web Belgesi",
        "role": "Viewer"
      },
      {
        "ext": "svg",
        "name": "Web Belgesi",
        "role": "Viewer"
      },
      {
        "ext": "webp",
        "name": "Web Belgesi",
        "role": "Viewer"
      }
    ],
    "win": {
      "icon": "icons/logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "perMachine": false,
      "installerIcon": "icons/logo.ico",
      "uninstallerIcon": "icons/logo.ico",
      "installerHeaderIcon": "icons/logo.ico",
      "uninstallDisplayName": "Anka Web",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Anka Web",
      "language": "1055",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "artifactName": "Anka_Web_${version}.${ext}"
    },
    "linux": {
      "icon": "icons/logo.png",
      "executableName": "anka-web",
      "category": "Network;WebBrowser",
      "synopsis": "Anka Web",
      "mimeTypes": [
        "text/html",
        "application/xhtml+xml",
        "application/pdf",
        "image/svg+xml",
        "image/webp",
        "x-scheme-handler/http",
        "x-scheme-handler/https"
      ],
      "target": [
        "tar.gz"
      ],
      "artifactName": "Anka_Web_${version}_${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wraitstudio-cmd",
        "repo": "Anka-Web",
        "private": false,
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "inquirer": "^14.2.5"
  }
}
