{
  "name": "anka-web",
  "version": "1.5.2",
  "description": "Anka Web Tarayıcısı",
  "main": "src/core/main/main.js",
"scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux dir --x64 && node build/pack-linux.js",
    "build:all": "npm run build:win && npm run build:linux",
    "pack:linux": "node build/pack-linux.js"
  },
  "author": "WraitGame <wraitstudio@gmail.com>",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.wraitgame.ankaweb",
    "productName": "Anka Web",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "electronLanguages": ["en-US", "tr"],
    "directories": {
      "output": "dist/${version}"
    },
    "files": [
      "src/**/*",
      "icons/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/*.ts",
      "!**/.git/**",
      "!**/node_modules/**/{test,tests,__tests__,example,examples,doc,docs,benchmark,benchmarks}/**",
      "!**/node_modules/**/*.{md,map,ts,tsx,yml,yaml,markdown}"
    ],
    "protocols": [
      {
        "name": "Web Baglantisi",
        "schemes": ["http", "https"]
      }
    ],
    "fileAssociations": [
      { "ext": "html", "name": "HTML Document", "role": "Viewer" },
      { "ext": "htm", "name": "HTML Document", "role": "Viewer" },
      { "ext": "xhtml", "name": "HTML Document", "role": "Viewer" },
      { "ext": "pdf", "name": "Web Belgesi", "role": "Viewer" },
      { "ext": "svg", "name": "Web Belgesi", "role": "Viewer" },
      { "ext": "webp", "name": "Web Belgesi", "role": "Viewer" }
    ],
    "win": {
      "icon": "src/icons/logo.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "msi", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "perMachine": false,
      "differentialPackage": false,
      "installerIcon": "src/icons/logo.ico",
      "uninstallerIcon": "src/icons/logo.ico",
      "installerHeaderIcon": "src/icons/logo.ico",
      "uninstallDisplayName": "Anka Web",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Anka Web",
      "language": "1055",
      "deleteAppDataOnUninstall": true,
      "runAfterFinish": true,
      "artifactName": "Anka_Web_${version}.${ext}"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "shortcutName": "Anka Web",
      "runAfterFinish": true,
      "artifactName": "Anka_Web_${version}_${arch}.${ext}"
    },
    "linux": {
      "icon": "src/icons/dark-logo.png",
      "executableName": "anka-web",
      "maintainer": "WraitGame <wraitstudio@gmail.com>",
      "category": "Network;WebBrowser",
      "synopsis": "Anka Web",
      "mimeTypes": [
        "text/html",
        "application/xhtml+xml",
        "application/pdf",
        "image/svg+xml",
        "image/webp",
        "x-scheme-handler/http",
        "x-scheme-handler/https"
      ],
      "target": ["dir"]
    }
  }
}